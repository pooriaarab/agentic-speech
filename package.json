{
  "name": "agentic-speech",
  "version": "0.1.0",
  "description": "Generate MP3 and WAV speech with ElevenLabs, OpenAI, and Cartesia through a TypeScript SDK, CLI, or MCP server with dry-run previews.",
  "keywords": [
    "text-to-speech",
    "speech-synthesis",
    "elevenlabs",
    "openai",
    "cartesia",
    "typescript",
    "sdk",
    "cli",
    "mcp",
    "mp3",
    "wav",
    "dry-run"
  ],
  "license": "MIT",
  "author": "Pooria Arab",
  "repository": {
    "type": "git",
    "url": "https://github.com/pooriaarab/agentic-speech.git"
  },
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "mcpName": "io.github.pooriaarab/agentic-speech",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "agentic-speech": "./dist/cli.js",
    "agentic-speech-mcp": "./dist/mcp-bin.js"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "agentic-core": "0.1.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  }
}
